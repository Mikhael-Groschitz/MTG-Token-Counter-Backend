# Copie este arquivo para .env (ou defina estas variáveis no seu ambiente/IDE)
# Nunca commite o arquivo .env real.

# --- Banco de dados (Neon PostgreSQL) ---
DB_URL=jdbc:postgresql://<seu-host>.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Facebook OAuth ---
# App ID/Secret de https://developers.facebook.com/apps/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- JWT (gere um valor aleatório com pelo menos 32 caracteres) ---
JWT_SECRET=

# --- Email (SMTP Gmail) ---
# GMAIL_USERNAME: endereço Gmail usado para enviar e-mails de verificação/recuperação
# GMAIL_APP_PASSWORD: senha de app gerada em https://myaccount.google.com/apppasswords
# (requer verificação em duas etapas ativada na conta)
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- Bug Report ---
# Opcional: para onde os reports de bug são enviados. Se vazio, usa o próprio GMAIL_USERNAME.
BUG_REPORT_EMAIL=
