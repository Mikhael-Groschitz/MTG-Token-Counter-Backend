# Copie este arquivo para .env (ou defina estas variáveis no seu ambiente/IDE)
# Nunca commite o arquivo .env real.

# --- Banco de dados (Neon PostgreSQL) ---
DB_URL=jdbc:postgresql://<seu-host>.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- JWT (gere um valor aleatório com pelo menos 32 caracteres) ---
JWT_SECRET=

# --- Email (Resend) ---
# RESEND_API_KEY: gerada em https://resend.com/api-keys
# RESEND_FROM_EMAIL: remetente (precisa ser de um domínio verificado no Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TokenForge <noreply@theforgeoftokens.com>

# --- Bug Report ---
# Opcional: para onde os reports de bug são enviados. Se vazio, usa o próprio RESEND_FROM_EMAIL.
BUG_REPORT_EMAIL=
